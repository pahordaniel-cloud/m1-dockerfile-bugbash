FROM registry.access.redhat.com/ubi9/ubi-minimal:9.4

# Image source labels, added by Datadog.
LABEL org.opencontainers.image.source="https://github.com/pahordaniel-cloud/m1-dockerfile-bugbash"
LABEL com.datadoghq.image.source_path="infra/base-images/Containerfile"

RUN microdnf install -y shadow-utils tar gzip && microdnf clean all \
 && useradd --uid 1001 --gid 0 appuser

USER 1001
